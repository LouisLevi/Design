{
  "mcpServers": {
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "nano-banana": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mindstone/mcp-server-nano-banana@0.4.1"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "NANO_BANANA_GEMINI_TIMEOUT_MS": "180000"
      }
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    }
  }
}
